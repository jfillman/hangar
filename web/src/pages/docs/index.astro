---
import Base from '../../layouts/Base.astro';
import { docSets, guides, productOf } from '../../data/docs';
import { u } from '../../lib/url';
import rules from '../../data/rules.generated.json';

const total = docSets.reduce((n, d) => n + d.pages, 0);
---
<Base title="Docs" description="User and admin documentation for every Hangar product, in one place." section="docs">
  <div class="wrap">
    <section class="hero">
      <p class="eyebrow">Docs · {total} pages</p>
      <h1>The Hangar docs, all in one place</h1>
      <p class="lede">
        Each product keeps its docs in its own repo, right next to the code, and this page gathers them up every time the
        site builds. If you use Hangar, start with a product's user guide. If you run it, the admin guides have the
        architecture, the operations and the reasoning behind each decision.
      </p>
    </section>

    <a class="card rules-card" href={u('docs/business-rules/')}>
      <span class="doc-card-head">
        <img class="mark" src={u('marks/hangar-tile.svg')} width="40" height="40" alt="" />
        <span>
          <strong>Business rules</strong>
          <span class="muted">{rules.total} rules, across every product</span>
        </span>
      </span>
      <p>
        Every rule Hangar applies to people, releases and clusters, how strongly each one holds, and what holds it. Kept in
        the Hangar repo next to the code and rebuilt with the site, so it never drifts.
      </p>
    </a>

    <div class="grid docs-grid">
      {docSets.map((d) => {
        const p = productOf(d.id);
        const g = guides(d);
        return (
          <section class="card doc-card">
            <a class="doc-card-head" href={u(d.home)}>
              <img class="mark" src={u(`marks/${d.id}-tile.svg`)} width="40" height="40" alt="" />
              <span>
                <strong>{p?.name ?? d.id}</strong>
                <span class="muted">{d.pages} {d.pages === 1 ? 'page' : 'pages'}</span>
              </span>
            </a>
            <p>{p?.tag}</p>
            <p class="doc-links">
              <a href={u(d.home)}>Overview</a>
              {g.user && <a href={u(g.user)}>User guide</a>}
              {g.admin && <a href={u(g.admin)}>Admin guide</a>}
            </p>
          </section>
        );
      })}
    </div>

    <div class="prose">
      <h2>A work in progress, on purpose</h2>
      <p>
        Some of these docs are thorough and some are still thin, and I'd rather show them as they are than hide them until
        they're perfect. Every page links back to its source on GitHub, so if something is wrong or missing, that's where
        to fix it.
      </p>
    </div>
  </div>
</Base>
<style>
  .docs-grid { margin: 1rem 0 3rem; }
  .rules-card { display: block; margin-top: 2rem; color: var(--ink); text-decoration: none; border-top: 3px solid var(--accent); }
  .rules-card p { max-width: 70ch; margin-top: 0.7rem; }
  .doc-card-head { display: flex; gap: 0.8rem; align-items: center; color: var(--ink); text-decoration: none; }
  .doc-card-head strong { display: block; font-size: 1.15rem; }
  .doc-card-head .muted { font-size: 0.85rem; }
  .doc-links { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; margin-top: auto; font-size: 0.95rem; }
</style>
