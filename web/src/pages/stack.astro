---
import Base from '../layouts/Base.astro';
import { layers, rails, tools } from '../data/stack';
import { u } from '../lib/url';

const groups = [...layers, ...rails];
const count = (key?: string) => tools.filter((t) => !key || t.layer === key).length;
const choices = tools.filter((t) => t.over).length;
---
<Base title="The stack" description="Every tool in Hangar as a decision: what I chose, what I chose it over, and why, layer by layer." section="stack">
  <div class="wrap">
    <section class="hero">
      <p class="eyebrow">The stack · Every tool is a decision</p>
      <h1>What I chose, what I chose it <em>over</em>, and why</h1>
      <p class="lede">
        Tool lists are cheap. What I find interesting is the trade-off behind each one, so here is every tool in Hangar
        as a decision, layer by layer. The {choices} cards with an amber edge are the ones where I picked one thing over
        another, and each card links to where I wrote the decision down.
      </p>
    </section>

    <div class="filters" role="group" aria-label="Filter by layer">
      <button type="button" data-k="" aria-pressed="true"><img src={u('marks/hangar-tile.svg')} alt="" width="20" height="20" />Everything <span class="n">{count()}</span></button>
      {groups.map((g) => (
        <button type="button" data-k={g.key} aria-pressed="false"><img src={u(`marks/${g.product}-tile.svg`)} alt="" width="20" height="20" />{g.name} <span class="n">{count(g.key)}</span></button>
      ))}
    </div>
    <label class="only"><input type="checkbox" id="only-choices" /> Only the choices where I picked one thing over another</label>

    {groups.map((g) => (
      <section class="layer" data-layer={g.key}>
        <div class="layer-h">
          <h2>{g.name}</h2>
          <p>{g.why}</p>
        </div>
        <div class="cards">
          {tools.filter((t) => t.layer === g.key).map((t) => (
            <article class={`decision${t.over ? ' vs' : ''}`} data-vs={t.over ? '1' : undefined}>
              <div class="top">
                <span class="eyebrow"><img src={u(`marks/${g.product}-tile.svg`)} alt="" width="18" height="18" />{g.name}</span>
                <span class={`chip ${t.status}`}>{t.status}</span>
              </div>
              <h3>{t.name}</h3>
              {t.over && <p class="over">over <s>{t.over}</s></p>}
              <p class="role">{t.role}</p>
              <p class="why">{t.why}</p>
              <a href={t.src}>Read the decision →</a>
            </article>
          ))}
        </div>
      </section>
    ))}

    <div class="prose after">
      <p>
        Want to see the same tools in the order a change meets them? The <a href={u('')}>homepage</a> follows one change
        from intent to production, and the <a href={u('platform/')}>platform page</a> shows how the pieces fit together.
      </p>
    </div>
  </div>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const only = document.getElementById('only-choices') as HTMLInputElement;
  let layer = '';
  const apply = () => {
    document.querySelectorAll<HTMLElement>('.layer').forEach((s) => {
      let visible = 0;
      s.querySelectorAll<HTMLElement>('.decision').forEach((c) => {
        c.hidden = only.checked && !c.dataset.vs;
        if (!c.hidden) visible++;
      });
      s.hidden = (layer !== '' && s.dataset.layer !== layer) || visible === 0;
    });
  };
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      layer = b.dataset.k || '';
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    }),
  );
  only.addEventListener('change', apply);
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 6px; margin: 2rem 0 0.8rem; }
  .filters button {
    display: inline-flex; align-items: center; gap: 0.45rem; font: inherit; font-size: 0.86rem; color: var(--ink);
    background: var(--raised); border: 1px solid var(--rule-strong); border-radius: 999px; padding: 0.3rem 0.8rem 0.3rem 0.35rem; cursor: pointer;
  }
  .filters button img { border-radius: 5px; }
  .filters button:hover { border-color: var(--accent); }
  .filters button[aria-pressed='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .filters .n { font-family: var(--font-mono); font-size: 0.7rem; color: var(--soft); }
  .filters button[aria-pressed='true'] .n { color: var(--paper); }
  .only { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; color: var(--muted); }
  .layer[hidden], .decision[hidden] { display: none; }
  .layer-h { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 1rem; border-bottom: 1px solid var(--rule); padding-bottom: 0.5rem; margin: 2.8rem 0 1rem; }
  .layer-h h2 { margin: 0; }
  .layer-h p { margin: 0; color: var(--muted); max-width: 60ch; }
  .cards { display: grid; gap: 0.8rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .decision { display: flex; flex-direction: column; gap: 0.45rem; background: var(--raised); border: 1px solid var(--rule); border-radius: 10px; padding: 1rem 1.1rem 1.1rem; }
  .decision.vs { border-top: 3px solid var(--accent); }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
  .top .eyebrow { display: flex; align-items: center; gap: 0.45rem; font-size: 0.64rem; }
  .top img { border-radius: 4px; }
  .decision h3 { margin: 0; font-size: 1.55rem; line-height: 1.05; }
  .over { margin: 0; font-family: var(--font-mono); font-size: 0.74rem; color: var(--muted); }
  .over s { color: var(--soft); }
  .role { margin: 0; font-size: 0.88rem; color: var(--muted); }
  .why { margin: 0; flex: 1; }
  .decision a { font-size: 0.88rem; }
  .after { margin-top: 3rem; }
</style>
