---
import Base from '../layouts/Base.astro';
import { glossary } from '../data/glossary';

const terms = [...glossary].sort((a, b) => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }));
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---
<Base title="Glossary" description="The jargon on this site in plain language: what each thing is, and why it matters in Hangar." section="glossary">
  <div class="wrap">
    <section class="hero">
      <p class="eyebrow">Glossary</p>
      <h1>The jargon, in <em>plain</em> words</h1>
      <p class="lede">
        Platform engineering comes with a lot of names. Here's what each one on this site means, and why it matters in
        Hangar. Across the site, the first mention of a term on a page has a dotted underline: hover or tap it for the
        short version.
      </p>
    </section>
    <dl class="terms">
      {terms.map((t) => (
        <div id={slug(t.term)}>
          <dt>{t.term}</dt>
          <dd><p>{t.what}</p><p class="why">{t.why}</p></dd>
        </div>
      ))}
    </dl>
  </div>
</Base>
<style>
  .terms { margin: 0; max-width: 52rem; }
  .terms div { display: grid; grid-template-columns: 1fr; gap: 0.2rem 2rem; padding: 1.1rem 0; border-top: 1px solid var(--rule); scroll-margin-top: 70px; }
  @media (min-width: 720px) { .terms div { grid-template-columns: 14rem 1fr; } }
  .terms dt { font-family: var(--font-serif); font-size: 1.4rem; line-height: 1.2; }
  .terms dd { margin: 0; }
  .terms p { margin: 0 0 0.3rem; }
  .terms .why { color: var(--muted); }
</style>
