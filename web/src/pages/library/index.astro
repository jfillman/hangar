---
import Base from '../../layouts/Base.astro';
import { bySet, diagrams, SET_LABELS, type Diagram } from '../../data/diagrams';
import { byKind, KIND_LABELS, papers, type Kind } from '../../data/library';
import { u } from '../../lib/url';
import { shortDate } from '../../lib/date';

const kinds: Kind[] = ['review', 'report', 'spec', 'architecture'];
const sets = [...new Set(diagrams.map((d) => d.set))] as Diagram['set'][];
const done = papers.filter((p) => p.status.tone === 'done').length;
const open = papers.filter((p) => p.status.tone === 'open').length;
const latest = [...papers].sort((a, b) => b.date.localeCompare(a.date))[0];
---
<Base title="Library" description={`The flight bag: all ${diagrams.length} Hangar diagrams and ${papers.length} reviews, reports and specs, each with where it stands.`} section="library">
  <div class="wrap">
    <section class="hero">
      <p class="eyebrow">Library · The flight bag</p>
      <h1>Everything I've <em>drawn</em>, and everything I've written down</h1>
      <p class="lede">
        A pilot's flight bag carries two things: the charts, and the paperwork. This is Hangar's. The charts are the
        diagrams, one idea per page. The paperwork is every review, report and spec, and each one says what happened
        next, because a review nobody acted on isn't worth keeping.
      </p>
    </section>

    <div class="shelves">
      <section class="shelf">
        <span class="eyebrow">Charts</span>
        <span class="count">{diagrams.length}</span>
        <h2><a class="cover" href={u('diagrams/')}>Diagrams</a></h2>
        <p>{sets.length} sets, from the whole platform at a glance down to one SLO poll tick.</p>
        <nav class="pills" aria-label="Diagram sets">
          {sets.map((s) => <a href={u(`diagrams/#${s}`)}>{SET_LABELS[s]} <span>{bySet(s).length}</span></a>)}
        </nav>
        <span class="go">Browse every diagram →</span>
      </section>
      <section class="shelf">
        <span class="eyebrow">Paperwork</span>
        <span class="count">{papers.length}</span>
        <h2><a class="cover" href={u('library/papers/')}>Everything written down</a></h2>
        <p>Every review, report, spec and architecture map, each saying where it stands today. Newest: {shortDate(latest.date)}.</p>
        <p><span class="chip built">{done} done</span> <span class="chip draft">{open} open</span></p>
        <nav class="pills" aria-label="Kinds of paper">
          {kinds.map((k) => <a href={u(`library/papers/#${k}`)}>{KIND_LABELS[k]} <span>{byKind(k).length}</span></a>)}
        </nav>
        <span class="go">Browse every paper →</span>
      </section>
    </div>
  </div>
</Base>
<style>
  .shelves { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); margin-bottom: 4rem; }
  .shelf {
    position: relative; display: flex; flex-direction: column; gap: 0.5rem; padding: 1.4rem 1.5rem 1.3rem;
    background: var(--raised); border: 1px solid var(--rule); border-top: 3px solid var(--accent); border-radius: 8px;
  }
  .shelf:hover { border-color: var(--accent); }
  .shelf h2 { margin: 0; font-size: 1.7rem; padding-right: 4rem; }
  .shelf .cover { color: inherit; text-decoration: none; }
  /* The whole card opens the shelf; the pills sit above that link and jump straight to a set or kind. */
  .shelf .cover::after { content: ''; position: absolute; inset: 0; border-radius: 8px; }
  .shelf p { margin: 0; color: var(--muted); max-width: 44ch; }
  .shelf .count { position: absolute; top: 1rem; right: 1.3rem; font-family: var(--font-serif); font-size: 3.2rem; line-height: 1; color: var(--accent); }
  .shelf .go { margin-top: auto; padding-top: 0.6rem; font-size: 0.92rem; color: var(--sky); }
  .pills { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.4rem; }
  .pills a { padding: 0.25rem 0.6rem; border: 1px solid var(--rule); border-radius: 999px; text-decoration: none; color: var(--ink); background: var(--paper); font-size: 0.84rem; }
  .pills a:hover { border-color: var(--accent); }
  .pills span { font-family: var(--font-mono); font-size: 0.72rem; color: var(--accent); margin-left: 0.2rem; }
</style>
