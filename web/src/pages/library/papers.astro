---
import Base from '../../layouts/Base.astro';
import { byKind, KIND_BLURBS, KIND_LABELS, papers, type Kind, type Paper } from '../../data/library';
import { u } from '../../lib/url';
import { shortDate } from '../../lib/date';

const kinds: Kind[] = ['review', 'report', 'spec', 'architecture'];
const link = (p: Paper) => (p.page && !p.href ? u(`library/${p.id}/`) : u(p.href!));
const tone = { done: 'built', open: 'draft', info: 'proposal' } as const;
const mark = (p: Paper) => u(`marks/${p.product === 'site' ? 'hangar' : p.product}-tile.svg`);
---
<Base title="Paperwork" description={`All ${papers.length} Hangar reviews, reports and specs, each with where it stands.`} section="library">
  <div class="wrap">
    <section class="hero">
      <p class="eyebrow"><a href={u('library/')}>Library</a> · Paperwork · {papers.length} papers</p>
      <h1>Every review, report, spec and map</h1>
      <p class="lede">
        The paperwork half of the flight bag. Each paper carries its status: what happened to a review's findings,
        what a report showed, or where a spec stands today. The illustrated ones open here; the rest link to where
        they already live on the site.
      </p>
    </section>
    <section class="papers">
      <div class="filter" role="group" aria-label="Show">
        <button type="button" data-kind="all" aria-pressed="true">All <span>{papers.length}</span></button>
        {kinds.map((k) => <button type="button" data-kind={k} aria-pressed="false">{KIND_LABELS[k]} <span>{byKind(k).length}</span></button>)}
      </div>
      {kinds.map((k) => (
        <section class="kind" id={k} data-kind={k}>
          <h3>{KIND_LABELS[k]}</h3>
          <p class="muted blurb">{KIND_BLURBS[k]}</p>
          <ol class="list">
            {byKind(k).map((p) => (
              <li>
                <a href={link(p)}>
                  <img class="mark" src={mark(p)} width="28" height="28" alt="" />
                  <span class="body">
                    <span class="eyebrow">{shortDate(p.date)} · {p.product === 'site' ? 'This site' : p.product[0].toUpperCase() + p.product.slice(1)}{p.page && ' · Illustrated'}</span>
                    <span class="t">{p.title}</span>
                    <span class="dek">{p.dek}</span>
                  </span>
                  <span class={`chip ${tone[p.status.tone]}`}>{p.status.label}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </section>
  </div>
</Base>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter button');
  const kinds = document.querySelectorAll<HTMLElement>('.papers .kind');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      kinds.forEach((k) => (k.hidden = b.dataset.kind !== 'all' && k.dataset.kind !== b.dataset.kind));
    }),
  );
</script>
<style>
  .papers { margin: 4rem 0 3rem; scroll-margin-top: 70px; }
  .papers > h2 { margin-bottom: 0.4rem; }
  .filter { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1.25rem 0 0.5rem; }
  .filter button {
    font: inherit; font-size: 0.88rem; cursor: pointer; padding: 0.3rem 0.75rem; border-radius: 999px;
    border: 1px solid var(--rule); background: transparent; color: var(--ink);
  }
  .filter button span { font-family: var(--font-mono); font-size: 0.72rem; color: var(--accent); margin-left: 0.2rem; }
  .filter button[aria-pressed='true'] { background: var(--accent-soft); border-color: var(--accent); }
  .kind { margin-top: 2rem; scroll-margin-top: 70px; }
  .kind h3 { margin: 0; font-size: 1.45rem; }
  .blurb { margin: 0.3rem 0 0.8rem; max-width: 62ch; }
  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .list li { border-bottom: 1px solid var(--rule); }
  .list a { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; gap: 0.3rem 1rem; align-items: start; padding: 1rem 0.25rem; color: inherit; text-decoration: none; }
  .list a:hover .t { color: var(--sky); }
  .list .mark { border-radius: 6px; box-shadow: 0 0 0 1px var(--rule); margin-top: 0.15rem; }
  .list .body { display: flex; flex-direction: column; gap: 0.2rem; }
  .list .t { font-family: var(--font-serif); font-size: 1.35rem; line-height: 1.2; }
  .list .dek { color: var(--muted); font-size: 0.95rem; line-height: 1.5; max-width: 66ch; }
  .list .chip { margin-top: 0.2rem; }
  @media (max-width: 640px) {
    .list a { grid-template-columns: 28px minmax(0, 1fr); }
    .list .chip { grid-column: 2; justify-self: start; }
  }
</style>
