---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import { gh } from '../lib/url';
import { longDate } from '../lib/date';

// The review itself is a standalone page in docs/reviews/ (copied into public/reviews/ by
// scripts/sync-assets.mjs), so it reads the same in TechDocs, on GitHub and here.
const review = { path: 'reviews/2026-09-27-architecture-review.html', date: '2026-09-27' };
---
<Base title="Architecture review" description="A staff platform architect's review of Hangar: would they approve it as the company's application and AI agent platform, and what would it take?" section="review">
  <div class="wrap">
    <section class="hero">
      <p class="eyebrow">Architecture review · {longDate(review.date)}</p>
      <h1>Would a staff architect <em>approve</em> Hangar?</h1>
      <p class="lede">
        I asked for the review I'd want before a company bet its platform on this: read every repo, weigh the
        architecture, the roadmap and what is really built, and decide. The answer is a conditional yes. The
        architecture is approved and a pilot is worth funding; production waits on five gates.
      </p>
      <ul class="facts">
        <li><span class="eyebrow">Verdict</span>Conditional approval</li>
        <li><span class="eyebrow">Findings</span>4 high, 5 medium, 1 low</li>
        <li><span class="eyebrow">Production gates</span>5, none passed yet</li>
      </ul>
    </section>

    <Frame path={review.path} title="Hangar Architecture Review: verdict, scorecard, findings, recommendations and approval gates" eyebrow={`Review · ${longDate(review.date)}`} />

    <p class="more">
      Source: <a href={gh('hangar', 'docs/reviews/README.md')}>docs/reviews</a> in the Hangar repo. Reviews are
      point-in-time records; the next one says what moved.
    </p>
  </div>
</Base>
<style>
  .facts { list-style: none; padding: 0; margin: 2rem 0 0; display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; }
  .facts li { display: flex; flex-direction: column; gap: 0.2rem; font-family: var(--font-serif); font-size: 1.5rem; line-height: 1.2; }
  .more { color: var(--muted); font-size: 0.95rem; max-width: var(--prose); margin-bottom: 3rem; }
</style>
