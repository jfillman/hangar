---
import Layout from '../../layouts/Clearance.astro';
import Packet from '../../components/clearance/Packet.astro';
import Closer from '../../components/clearance/Closer.astro';
import RecordLayers from '../../components/clearance/RecordLayers.astro';
import AuditorDesk from '../../components/clearance/AuditorDesk.astro';
import Clearinghouse from '../../components/clearance/Clearinghouse.astro';
import { u } from '../../lib/url';
const c = (p = '') => u(`clearance/${p}`);
const fields = [
  ['Identities', 'Agent identity and tool version; initiating human; approver subjects and issuers'],
  ['Source', 'Repository, revision, rendered tree root and per-object hashes; image digests as a cross-reference'],
  ['Target', 'Cluster, environment, Argo application'],
  ['Provenance', 'Confidence level and the signals behind it, each tagged verified or claimed'],
  ['Decision', 'Tier, policy version, rules fired, plain-language reason, approval channel, token reference'],
  ['Outcome', 'Deployment result, observed revision, health check, rollback if any'],
  ['Coverage', 'Authorized and verified · observed, not attributed · out-of-band detected · coverage unavailable'],
  ['Assurance', 'Checkpointed · recorded, not yet checkpointed · not recorded: whether the record has reached a witnessed checkpoint'],
  ['Intent', 'A task reference and a secret-scrubbed summary by default; full text only where a repo opts in'],
  ['Integrity', 'Timestamps, signature, checkpoint reference, verification status'],
];
---
<Layout title="Evidence and ledger" page="ledger" description="Clearance's evidence record, in-toto attestations, the audit packet, and a witnessed ledger of hashes that nobody can quietly rewrite, not even its operator.">
  <section class="page-hero">
    <div class="clr-wrap">
      <p class="kicker">Evidence and the Clearance Ledger</p>
      <h1 class="display">A record <em>nobody</em> can quietly rewrite.</h1>
      <p class="sub">Not you, not us, not a database admin having a bad week. Your records stay on your own storage. The ledger holds only their hashes, and independent witnesses refuse any history shorter than the last one they saw, so even whoever holds the signing key can't rewrite it unseen. Anyone can check it with an open tool.</p>
    </div>
  </section>

  <section class="clr-wrap" data-reveal>
    <figure class="fig">
      <svg viewBox="0 0 1000 400" role="img" aria-label="Records stay on your storage. Only their hashes go into the ledger, a Tessera log, which publishes signed checkpoints. Independent witnesses demand a consistency proof and never accept a smaller tree. If an admin edits a record, clearance verify names the altered line. If the operator truncates the log and re-signs, the witnesses refuse the checkpoint.">
        <defs><marker id="lg-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="var(--muted)"/></marker>
        <marker id="lg-r" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="var(--bad)"/></marker></defs>
        <text x="20" y="34" font-size="17" font-weight="500" fill="var(--ink)">Why a rewritten history fails verification</text>
        <text x="20" y="74" font-size="11" class="mono" fill="var(--soft)">YOUR STORAGE · YOUR RETENTION</text>
        {[0, 1, 2, 3, 4].map((i) => (
          <g transform={`translate(${20 + i * 92} 90)`}>
            <rect width="80" height="64" rx="8" fill={i === 2 ? 'color-mix(in srgb, var(--bad) 10%, var(--raised))' : 'var(--raised)'} stroke={i === 2 ? 'var(--bad)' : 'var(--rule-strong)'} stroke-width="1.3"/>
            <text x="10" y="20" font-size="10.5" class="mono" fill="var(--muted)">rec {412 + i}</text>
            <rect x="10" y="30" width="44" height="5" rx="2" fill="var(--paper-2)"/><rect x="10" y="40" width="58" height="5" rx="2" fill="var(--paper-2)"/>
            <text x="10" y="58" font-size="10" class="mono" fill={i === 2 ? 'var(--bad)' : 'var(--clr)'}>{i === 2 ? 'edited' : 'h ✓'}</text>
            {i < 4 && <path d="M80 32 H92" stroke="var(--rule-strong)" stroke-width="1.5"/>}
          </g>
        ))}
        <path d="M244 186 V160" fill="none" stroke="var(--bad)" stroke-width="1.3" marker-end="url(#lg-r)"/>
        <rect x="128" y="188" width="160" height="40" rx="8" fill="none" stroke="var(--bad)" stroke-dasharray="4 4"/>
        <text x="208" y="204" text-anchor="middle" font-size="11.5" fill="var(--bad)">admin edits rec 414</text>
        <text x="208" y="220" text-anchor="middle" font-size="10.5" fill="var(--muted)">and recomputes the chain</text>
        <path d="M452 122 H546" fill="none" stroke="var(--muted)" stroke-width="1.3" marker-end="url(#lg-a)"/>
        <text x="499" y="112" text-anchor="middle" font-size="11" fill="var(--muted)">hashes only</text>
        <rect x="550" y="70" width="190" height="124" rx="10" fill="color-mix(in srgb, var(--sky) 9%, var(--raised))" stroke="var(--sky)" stroke-width="1.6"/>
        <text x="564" y="88" font-size="10.5" class="mono" fill="var(--sky)">LEDGER</text>
        <g stroke="var(--sky)" stroke-width="1.2" fill="none"><path d="M645 106 L615 132 M645 106 L675 132 M615 132 L600 158 M615 132 L630 158 M675 132 L660 158 M675 132 L690 158"/></g>
        <circle cx="645" cy="104" r="5" fill="var(--sky)"/>
        <circle cx="615" cy="134" r="4" fill="color-mix(in srgb, var(--sky) 55%, transparent)"/><circle cx="675" cy="134" r="4" fill="color-mix(in srgb, var(--sky) 55%, transparent)"/>
        {[600, 630, 660, 690].map((x) => <rect x={x - 7} y="158" width="14" height="12" rx="2" fill="color-mix(in srgb, var(--sky) 35%, transparent)"/>)}
        <text x="645" y="187" text-anchor="middle" font-size="11.5" fill="var(--muted)">Tessera log of record hashes</text>
        <path d="M645 194 V222" fill="none" stroke="var(--muted)" stroke-width="1.3" marker-end="url(#lg-a)"/>
        <rect x="550" y="226" width="190" height="50" rx="10" fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="1.6"/>
        <text x="645" y="246" text-anchor="middle" font-size="13" fill="var(--ink)" font-weight="500">Signed checkpoint</text>
        <text x="645" y="264" text-anchor="middle" font-size="10.5" class="mono" fill="var(--muted)">n=416 · root 7c41…</text>
        <path d="M740 251 H768 V90" fill="none" stroke="var(--rule-strong)" stroke-width="1.3"/>
        <g fill="none" stroke="var(--muted)" stroke-width="1.3" marker-end="url(#lg-a)"><path d="M768 90 H786"/><path d="M768 140 H786"/><path d="M768 190 H786"/></g>
        {['A witness Clearance runs', 'A witness you run', 'Your auditor, as a witness'].map((t, i) => (
          <g>
            <rect x="790" y={70 + i * 50} width="190" height="40" rx="8" fill="var(--raised)" stroke="var(--rule-strong)" stroke-width="1.3"/>
            <text x="804" y={95 + i * 50} font-size="12" fill="var(--ink)">{t}</text>
            <path d={`M955 ${88 + i * 50} l4 4 l8 -9`} fill="none" stroke="var(--clr)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </g>
        ))}
        <g font-size="11.5" fill="var(--muted)"><text x="790" y="234">each demands a consistency proof,</text><text x="790" y="250">keeps the last checkpoint it saw,</text><text x="790" y="266">and never accepts a smaller tree</text></g>
        <rect x="790" y="296" width="190" height="44" rx="8" fill="none" stroke="var(--bad)" stroke-dasharray="4 4"/>
        <text x="885" y="314" text-anchor="middle" font-size="11.5" fill="var(--bad)">operator truncates to n=410</text>
        <text x="885" y="331" text-anchor="middle" font-size="10.5" fill="var(--muted)">and re-signs a clean checkpoint</text>
        <text x="885" y="362" text-anchor="middle" font-size="12" class="mono" fill="var(--bad)">✕ refused: 410 &lt; 416</text>
        <rect x="20" y="306" width="740" height="64" rx="10" fill="var(--cockpit, #0b0d10)"/>
        <text x="40" y="332" font-size="12" class="mono" fill="#5fae84">$ clearance verify packet.json --logs ./records</text>
        <text x="40" y="352" font-size="12" class="mono" fill="#d9796c">✕ rec 414, line 3: hash differs from the committed leaf</text>
        <path d="M208 228 V302" fill="none" stroke="var(--bad)" stroke-width="1.3" stroke-dasharray="4 4" marker-end="url(#lg-r)"/>
      </svg>
      <figcaption>Integrity · Hashes committed, history witnessed</figcaption>
    </figure>
  </section>

  <section class="sec">
    <div class="clr-wrap">
      <div class="sec-head" data-reveal>
        <p class="kicker">The record</p>
        <h2 class="h2">One versioned record per clearance event. <em>Verified</em> or <em>claimed</em>, field by field.</h2>
        <p class="sub">The record is a first-class data model, not a report stitched from logs after the fact. Every field says whether Clearance checked it (a signature it verified) or an integration asserted it (a header GitHub forwarded). The distinction survives into the packet.</p>
      </div>
      <div data-reveal><RecordLayers /></div>
      <div class="cmp table-wrap" data-reveal>
        <table>
          <thead><tr><th>Field group</th><th>Contents</th></tr></thead>
          <tbody>{fields.map(([k, v]) => <tr><td>{k}</td><td>{v}</td></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="clr-wrap">
      <div class="feature" data-reveal>
        <div>
          <p class="kicker">Attestations</p>
          <h2 class="h2">The next link in a chain that <em>already exists</em>.</h2>
          <p class="sub">Every cleared change emits a Clearance Change Attestation as an in-toto Statement. Its subjects are the rendered tree and the image digests that landed; its predicate carries the control assertions, approvals, policy version, outcome, and a scope-and-limitations block naming what wasn't verified.</p>
          <ul class="points">
            <li><b>Signed with Sigstore</b>, keyless, beside the SLSA provenance Tekton Chains already emits in Glidepath.</li>
            <li><b>One walk</b> from build to clearance to deployment, for any verifier.</li>
            <li><b>Limitations in the payload,</b> so a coverage gap travels with the claim.</li>
          </ul>
        </div>
        <div class="cockpit" role="img" aria-label="An in-toto Statement for a cleared skyport-broker change">
          <div class="chrome"><span class="dots"><i></i><i></i><i></i></span><span class="crumb">attestation · <b>change-attestation/v1</b></span></div>
<div class="code">{'{'}
  <span class="k">"_type"</span>: <span class="s">"https://in-toto.io/Statement/v1"</span>,
  <span class="k">"subject"</span>: [
    {'{'} <span class="k">"name"</span>: <span class="s">"argocd://prod/skyport-broker/tree"</span>,
      <span class="k">"digest"</span>: {'{'} <span class="k">"sha256"</span>: <span class="s">"e71d…"</span> {'}'} {'}'},
    {'{'} <span class="k">"name"</span>: <span class="s">"ghcr.io/jfillman/skyport-broker"</span>,
      <span class="k">"digest"</span>: {'{'} <span class="k">"sha256"</span>: <span class="s">"9f1c…"</span> {'}'} {'}'} ],
  <span class="k">"predicateType"</span>: <span class="s">"https://clearance.hangarplatform.dev/change-attestation/v1"</span>,
  <span class="k">"predicate"</span>: {'{'}
    <span class="k">"tier"</span>: <span class="n">2</span>,
    <span class="k">"policy"</span>: {'{'} <span class="k">"ref"</span>: <span class="s">"clearance.yaml@7e2d"</span>, <span class="k">"verdict"</span>: <span class="g">"pass"</span> {'}'},
    <span class="k">"approvals"</span>: [{'{'} <span class="k">"sub"</span>: <span class="s">"okta|00u9…"</span>, <span class="k">"verified"</span>: <span class="g">true</span> {'}'}],
    <span class="k">"provenance"</span>: {'{'} <span class="k">"level"</span>: <span class="s">"probable-agent"</span>,
                    <span class="k">"claimed"</span>: [<span class="s">"agent-header"</span>] {'}'},
    <span class="k">"outcome"</span>: {'{'} <span class="k">"applied"</span>: <span class="g">true</span>, <span class="k">"health"</span>: <span class="g">"healthy"</span> {'}'},
    <span class="k">"coverage"</span>: <span class="g">"authorized-and-verified"</span>,
    <span class="k">"limitations"</span>: [<span class="s">"drift observed at 60 s intervals"</span>]
  {'}'}
{'}'}</div>
        </div>
      </div>
      <div class="feature flip" data-reveal>
        <div>
          <p class="kicker">The audit packet</p>
          <h2 class="h2">A PDF is the <em>cover</em>, not the product.</h2>
          <p class="sub">For any date range: JSON as the canonical form, CSV and PDF as presentation layers. Counts by provenance, the share cleared by policy versus by a person, every tier 2 and 3 change with its approver and token, every exception, policy changes in the period, and instructions for verifying it all.</p>
          <ul class="points">
            <li><b>Control mappings ship as data.</b> SOC 2 CC8.1 first. PCI DSS 6.5.1 and ISO 27001 A.8.32 after an auditor has reviewed them.</li>
            <li><b>Always a coverage statement.</b> What the record does and doesn't include, in plain words.</li>
          </ul>
        </div>
        <Packet />
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="clr-wrap">
      <div class="sec-head" data-reveal>
        <p class="kicker">Three rules for the proof</p>
        <h2 class="h2">A hash chain proves consistency. It doesn't prove <em>immutability</em>.</h2>
        <p class="sub">Whoever can rewrite the database can recompute the chain, and a truncated tail still looks valid. So the ledger follows the proof design Traefik's Sovereign Trust Plane set for the request path, on the same open log library and witness formats, so one verifier reads both.</p>
      </div>
      <div class="bento" data-reveal>
        <div class="tile span-2"><p class="kicker">01 · Hashes, never content</p><h3>Nothing sensitive leaves.</h3><p>Records, diffs and gateway audit lines stay on your storage under your retention. The ledger holds their hashes in a Merkle tree with signed checkpoints. No added latency, and an air-gapped tenant anchors offline.</p></div>
        <div class="tile span-2"><p class="kicker">02 · Witnesses with a rule</p><h3>History can only grow.</h3><p>A witness sees only checkpoints, demands proof that the new tree extends the old one, countersigns, and never accepts a smaller tree. A shortened history is caught even when the key holder did it.</p></div>
        <div class="tile span-2"><p class="kicker">03 · Verify from the originals</p><h3>It names the line.</h3><p><code>clearance verify</code> reads your own files, checks signatures and countersignatures, proves inclusion, recomputes every hash and points at the exact line that changed. Offline, if you like.</p></div>
      </div>
      <div class="cols mt-2" data-reveal>
        <div><p class="kicker">Two honest caveats</p></div>
        <div>
          <p><b>Integrity is not accuracy.</b> The ledger proves entries weren't rewritten. Whether an entry is true is what the verified-or-claimed tag on each field says, and the packet never implies more.</p>
          <p><b>Enforcement and assurance can drift apart.</b> If a witness goes quiet, records keep being written but no new checkpoint is published. Every record carries its assurance state (checkpointed, recorded but not yet checkpointed, or not recorded), Tower alerts on it, the packet reports the window, and by default a tier 3 change waits until evidence can be witnessed again.</p>
        </div>
      </div>
      <div class="mt-2" data-reveal><AuditorDesk /></div>
    </div>
  </section>

  <section class="sec">
    <div class="clr-wrap">
      <div class="cols" data-reveal>
        <div>
          <p class="kicker">What a witness is</p>
          <h2 class="h2" style="font-size:clamp(1.8rem,2.6vw + 0.6rem,2.6rem)">A small server that remembers <em>one</em> thing.</h2>
        </div>
        <div>
          <p>A witness is run by a party the log operator doesn't control, with its own signing key. It never sees a record. It sees checkpoints: a few bytes saying "the log now has 48,213 entries and the root of that tree is H", plus a consistency proof that the new tree extends the last one it accepted. It countersigns, remembers that checkpoint, and never accepts a smaller tree.</p>
          <p>The qualitative step is from zero witnesses to one. With none, whoever holds the signing key can truncate history and re-sign a clean checkpoint. With one, they can't do it unseen. More witnesses buy availability and lower collusion risk, not more truth. The operator is never its own witness: hosted plans need at least one witness outside Clearance before a record is called independently witnessed, and a self-hosted customer's witness protects their auditor from their own administrators.</p>
          <p>Reading a record doesn't make you a witness. But every verifier is a weak one: <code>clearance verify</code> keeps a note of the checkpoints it has seen and reports a later one that doesn't extend them, which catches an operator showing different histories to different people.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="clr-wrap">
      <div class="sec-head" data-reveal>
        <p class="kicker">Three levels of trust</p>
        <h2 class="h2">Different claims, kept <em>apart</em>.</h2>
        <p class="sub">The operator of a control doesn't certify its own work. Clearance keeps these three distinct because they carry different claims and different liability.</p>
      </div>
      <div class="status-band" data-reveal>
        <div><span class="chip built" style="color:var(--muted)">Level 1</span><h3 style="font-family:var(--font-serif);font-size:1.5rem;margin:0.8rem 0 0">Signed record</h3><p>"Clearance issued this statement, and it hasn't changed since signing." A technical capability.</p></div>
        <div style="border-color:var(--clr);box-shadow:0 0 0 1px var(--clr)"><span class="chip built">Level 2 · the product</span><h3 style="font-family:var(--font-serif);font-size:1.5rem;margin:0.8rem 0 0">Verified control evidence</h3><p>"Within this declared scope, we verified these control events and found these exceptions."</p></div>
        <div><span class="chip proposal">Level 3</span><h3 style="font-family:var(--font-serif);font-size:1.5rem;margin:0.8rem 0 0">Independent assurance</h3><p>"An independent assessor evaluated the control against a stated criterion." Through audit partners only, never self-issued. Their acceptance receipt is signed with their key, and only then written to the ledger.</p></div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="clr-wrap">
      <div class="sec-head" data-reveal>
        <p class="kicker">Your data</p>
        <h2 class="h2">Three layers, written into the <em>agreement</em> before the first install.</h2>
      </div>
      <div class="cmp table-wrap" data-reveal>
        <table>
          <thead><tr><th>Layer</th><th>Contents</th><th>Default</th></tr></thead>
          <tbody>
            <tr><td>Customer evidence</td><td>Individual records, approvers, outcomes, policies</td><td>Tenant-isolated: one database and one signing identity per tenant, never cross-tenant</td></tr>
            <tr><td>Derived customer intelligence</td><td>Your patterns, bottlenecks, exception rates</td><td>Yours, under your subscription</td></tr>
            <tr><td>Shared intelligence</td><td>Aggregated benchmarks and change patterns</td><td>Opt-in, aggregate only, with thresholds before anything is published</td></tr>
          </tbody>
        </table>
      </div>
      <p class="note">Prompts and intent are redacted by default to a task reference and a secret-scrubbed summary. Full text is opt-in, per repository, with its own retention.</p>
    </div>
  </section>

  <section class="sec">
    <div class="clr-wrap">
      <div class="sec-head" data-reveal>
        <p class="kicker">The third direction</p>
        <h2 class="h2">The auditor's acceptance is a record <em>too</em>.</h2>
        <p class="sub">Your packet reaches your assurance provider, a GRC hub, an audit firm or a readiness assessor, in the shape they already accept. They verify with the open tool, ideally against their own witness. When they accept the packet for an engagement, they sign a receipt with their own key, and the receipt goes into the ledger beside the changes it covers.</p>
      </div>
      <div class="cols" data-reveal>
        <div>
          <div class="cockpit code">{`{
  "type": "acceptance-receipt/v1",
  "packet": "packet-skyport-2027-q1",
  "engagement": "soc2-type2-2027",
  "framework": "soc2/2027-draft",
  "mapping": "soc2-2027-draft@v3",
  "checkpoint": { "size": 48213, "root": "b8e0…" },
  "verdict": "accepted-with-notes",
  "notes": [ { "row": "CC7.1-approvals", "note": "sample of 25 traced" } ],
  "signer": { "iss": "https://firm.example", "sub": "engagement-lead" }
}`}</div>
        </div>
        <div>
          <h3>Independence, kept the way the hubs keep it</h3>
          <p>You grant the recipient access. Clearance delivers the packet and records that it did. The recipient pulls, verifies and signs. Clearance never submits on your behalf and never issues a verdict of its own.</p>
          <h3>Feedback lands on a row</h3>
          <p>Every mapping row carries a stable id, so a questioned or rejected control comes back with its reason attached to the row that claimed it. The next mapping version is built from that feedback, and every packet names the version it was built with.</p>
          <h3>Reused, not re-explained</h3>
          <p>A trust page built from receipts tells a vendor-risk reviewer which firm accepted change-control evidence for which engagement, verifiable like everything else in the ledger. Auditor-side tooling, witness operation and packet intake are free, always.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="clr-wrap">
      <div class="sec-head" data-reveal>
        <p class="kicker">Standards in motion</p>
        <h2 class="h2">Built for the criteria as they'll read in <em>2027</em>.</h2>
        <p class="sub">Three standards bodies published or drafted AI-specific material between February and October 2026, and one of them renumbers the control the first packet is named after. None is mandatory today, and Clearance never claims a standard mandates it. The rule that follows: a mapping is data keyed by framework, version and control; a record never names a control; the packet joins the two at export time against the version your engagement runs under.</p>
      </div>
      <div class="cmp table-wrap" data-reveal>
        <table>
          <thead><tr><th>Standard</th><th>What's changing</th><th>What Clearance does about it</th><th>Status</th></tr></thead>
          <tbody>
            <tr><td>SOC 2 TSC, 2027 exposure draft</td><td>Common criteria go from 33 to 20. Change management moves from CC8.1 to CC7.1 through CC7.3. AI points of focus in 17 criteria, including access reviews that cover AI accounts. Published Oct 28, 2026; engagements from Dec 31, 2027.</td><td>Mappings carry soc2/2017 and soc2/2027-draft side by side. The packet gains an AI identities section: agents seen in the period, their sponsors, last review.</td><td><span class="chip proposal">Proposal</span></td></tr>
            <tr><td>PCI DSS 6.5.1 and the AI supplement</td><td>Per change: reason, security impact, approval, testing, back-out. The Sep 15, 2026 supplement adds "least agency", "monitored autonomy" and a named person accepting responsibility for AI output.</td><td>Two fields join the record's decision group: security impact and back-out. A tier 3 change gets a generated impact statement; back-out is the previous cleared tree root. The approver subject is the named responsible person.</td><td><span class="chip draft">Draft</span></td></tr>
            <tr><td>NIST AI Agent Standards Initiative, 800-53 COSAiS overlays</td><td>Asks how agents log actions tamper-proofly and achieve non-repudiation; names multi-hop delegation as unsolved. Agent overlays in drafting.</td><td>The witnessed ledger is the tamper-proof log; narrow-only token exchange is the answer to multi-hop. A nist-800-53/cosais-agent mapping is reserved, empty until the drafts publish.</td><td><span class="chip proposal">Proposal</span></td></tr>
            <tr><td>EU AI Act, Articles 12 and 14</td><td>Automatic event logging and human oversight with an override and halt, for high-risk systems. Ordinary coding agents aren't high-risk.</td><td>The runtime record already carries the Article 12 minimum: initiating user, model and tool version, intent, output as the tree root, reviewer, disposition. Break-glass and the hook's deny path are the override and halt.</td><td><span class="chip built">Built</span> runtime · <span class="chip proposal">Proposal</span> deployment</td></tr>
            <tr><td>ISO 27001 A.8.32, ISO 42001</td><td>A.8.32 unchanged; no AI amendment known. 42001 governs the AI management system, not infrastructure change.</td><td>A.8.32 mapping unchanged. No 42001 mapping: a customer certifying to it points their auditor at the SOC 2 and A.8.32 packets.</td><td><span class="chip proposal">Proposal</span></td></tr>
          </tbody>
        </table>
      </div>
      <div class="cols mt-2" data-reveal>
        <div>
          <h3>A mapping is a file</h3>
          <p>One per framework version, shipped as data and versioned with the product. A control with no record field behind it is reported as not evidenced by Clearance, never silently left out. Standards change rarely; the mapping changes often, and the mapping is what's versioned. The published form is OSCAL, so your GRC tooling imports it and your auditor reads a format they already know.</p>
        </div>
        <div class="cockpit code">{`framework: soc2
version: 2027-draft        # or 2017
asOf: 2026-10-30
controls:
  - id: CC7.1
    title: System development and change management
    supersedes: { framework: soc2, version: "2017", id: CC8.1 }
    evidence:
      - field: decision.approvals        # named human or policy
      - field: decision.policy.ref       # policy version in force
      - field: outcome.observedRevision  # what landed
      - section: exceptions              # out-of-band, break-glass`}</div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="clr-wrap">
      <div class="cols" data-reveal>
        <div>
          <p class="kicker">Why the ledger matters</p>
          <h2 class="h2" style="font-size:clamp(1.8rem,2.6vw + 0.6rem,2.6rem)">The gate can be copied. <em>Being believed</em> can't.</h2>
        </div>
        <div>
          <p>Any platform team with a free sprint can build an approval gate. What a copy starts without is a verified link between authorization and deployment that third parties already rely on, explicit statements of what was and wasn't covered, and, over time, a dataset relating change shapes to control outcomes.</p>
          <p>A witnessed log is no longer rare: Traefik ships one for the request path, and Clearance borrows its proof design on purpose. The gate is copyable. A record store is copyable. What isn't copyable is a clearinghouse: the position between the people who make changes and the people who have to believe them. That position is the paid product.</p>
          <p>So verification is free and open, forever. The authority comes from the log's witnesses, not from Clearance's word, and Clearance is never the only verifier of its own ledger. Where Traefik's public witness accepts outside checkpoints, Clearance nominates it, so one auditor's verifier checks the call log and the deployment log alike. An auditor who has verified one witnessed packet tends to ask the next client why theirs isn't.</p>
        </div>
      </div>
      <div class="mt-2" data-reveal><Clearinghouse /></div>
    </div>
  </section>

  <Closer />
</Layout>
