---
import { u } from '../../lib/url';
const ticks = [0, 45, 90, 135, 180, 225, 270, 315];
const pins: [number, number, string][] = [[95, 70, '1'], [48, -6, '2'], [70, 25, '3'], [76, 61, '4']];
---
<div class="mark-sec">
  <figure class="mark-stage cockpit" data-reveal>
    <svg viewBox="-14 -14 124 124" role="img" aria-label="The Clearance mark at full size: the Hangar instrument dial with its amber heading bug, a green check, and a hold-short line below it, one solid and one dashed">
      <defs>
        <radialGradient id="mk-glow" cx="50%" cy="46%" r="50%">
          <stop offset="0" stop-color="#5FAE84" stop-opacity="0.22"/>
          <stop offset="1" stop-color="#5FAE84" stop-opacity="0"/>
        </radialGradient>
      </defs>
      <circle cx="48" cy="48" r="58" fill="url(#mk-glow)"/>
      <circle cx="48" cy="48" r="40" fill="none" stroke="#262C33" stroke-width="2"/>
      <g stroke="#66717B" stroke-width="2">
        {ticks.map((a) => <line x1="48" y1="8" x2="48" y2="15" transform={`rotate(${a} 48 48)`} />)}
      </g>
      <polygon points="44,2 52,2 48,9" fill="#E8A33D"/>
      <path class="mk-check" d="M35,37 L44.5,46.5 L61.5,29.5" fill="none" stroke="#5FAE84" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>
      <line x1="29" y1="57" x2="67" y2="57" stroke="#5FAE84" stroke-width="3.2" stroke-linecap="round"/>
      <line x1="29" y1="65" x2="67" y2="65" stroke="#5FAE84" stroke-width="3.2" stroke-dasharray="5.5 4.3"/>
      <g class="mk-pins">
        <path d="M84.5 68.5 L91.5 69.5" stroke="#838B93" stroke-width="0.5"/>
        <path d="M63.5 28.5 L66.8 26.5" stroke="#838B93" stroke-width="0.5"/>
        <path d="M68.5 61 L72.4 61" stroke="#838B93" stroke-width="0.5"/>
        {pins.map(([x, y, n]) => (
          <g>
            <circle cx={x} cy={y} r="3.6" fill="#0B0D10" stroke="#838B93" stroke-width="0.5"/>
            <text x={x} y={y + 1.5} text-anchor="middle" font-size="4.2" fill="#E8E4DC" font-family="Geist Mono, monospace">{n}</text>
          </g>
        ))}
      </g>
    </svg>
    <figcaption class="mark-sizes" aria-label="The same mark at 64, 40, 24 and 16 pixels">
      {[64, 40, 24, 16].map((s) => (
        <span><img src={u('marks/clearance-tile.svg')} width={s} height={s} alt="" /><small>{s}</small></span>
      ))}
    </figcaption>
  </figure>
  <div class="mark-copy" data-reveal>
    <p class="kicker">The mark</p>
    <h2 class="h2">Hold short. Then <em>cleared</em>.</h2>
    <p class="sub">Clearance flies its own colours and still wears the family instrument. Every Hangar product sits on the same dial; this one puts the moment it exists for at the centre.</p>
    <ol class="mark-parts">
      <li><b>The dial.</b> The ring and eight ticks every Hangar mark shares. Same panel, different gauge.</li>
      <li><b>The heading bug.</b> The family's one amber constant, still pointing north.</li>
      <li><b>The check.</b> Cleared, in green: the single word a change is waiting to hear.</li>
      <li><b>The hold-short line.</b> One solid, one dashed, like the paint before a runway. Nothing crosses it without a clearance.</li>
    </ol>
  </div>
</div>
