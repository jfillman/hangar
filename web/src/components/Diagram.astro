---
// Embeds one diagram. Each is a whole HTML document from tools/diagrams, so it goes in a
// same-origin iframe that sizes itself to its content and follows the page's theme.
import { diagram } from '../data/diagrams';
import { u } from '../lib/url';

interface Props { id: string; caption?: string; }
const { id, caption } = Astro.props;
const d = diagram(id);
const src = u(d.path);
---
<figure class="diagram">
  <iframe src={src} title={d.title} loading="lazy" data-autosize height="720"></iframe>
  <figcaption>
    <span class="eyebrow">{d.eyebrow}</span>
    <span class="t">{caption ?? d.title}</span>
    <a href={src} target="_blank" rel="noopener">Open full page ↗</a>
  </figcaption>
</figure>

<script>
  import '../lib/autosize';
</script>

<style>
  .diagram { margin: 2rem 0; border: 1px solid var(--rule); border-radius: 8px; overflow: hidden; background: var(--paper); }
  iframe { display: block; width: 100%; border: 0; background: var(--paper); }
  figcaption {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 1rem;
    padding: 0.7rem 1rem; border-top: 1px solid var(--rule); background: var(--raised); font-size: 0.9rem;
  }
  figcaption .t { flex: 1 1 30ch; color: var(--muted); }
  figcaption a { font-size: 0.85rem; white-space: nowrap; }
</style>
